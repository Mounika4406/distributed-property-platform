# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=property_db

# Region Connection Strings (Internal Docker Network)
DATABASE_URL_US=postgresql://postgres:postgrespassword@db-us:5432/property_db
DATABASE_URL_EU=postgresql://postgres:postgrespassword@db-eu:5432/property_db

# Kafka Configuration
KAFKA_BROKER=kafka:29092
KAFKA_TOPIC=property-updates

# Backend Application Settings
PORT=8000
HOST=0.0.0.0
